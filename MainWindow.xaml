<Window x:Class="KeysVisorOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeysVisorOverlay"
        Width="430"
        Height="158"
        MinWidth="360"
        MinHeight="136"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Reset" Click="Reset_Click" />
            <MenuItem Header="Hide / Show" Click="ToggleVisibility_Click" />
            <Separator />
            <MenuItem Header="Exit" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="DragSurface"
            MouseLeftButtonDown="DragSurface_MouseLeftButtonDown"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#55FFFFFF"
            Background="#DC090C12"
            Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.42"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="KeysVisorOverlay"
                           Foreground="#FFF6F7FB"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="HookStatusText"
                           Text="Starting"
                           Foreground="#FF7DE2D1"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="KPS"
                               Foreground="#FF9CA3AF"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="KpsText"
                               Text="0"
                               Foreground="#FFF6F7FB"
                               FontSize="34"
                               FontWeight="Bold"
                               LineHeight="35" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="MAX"
                               Foreground="#FF9CA3AF"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="MaxText"
                               Text="0"
                               Foreground="#FFFF8BA7"
                               FontSize="24"
                               FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="AVG"
                               Foreground="#FF9CA3AF"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="AvgText"
                               Text="0.0"
                               Foreground="#FF7DE2D1"
                               FontSize="24"
                               FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="TOTAL"
                               Foreground="#FF9CA3AF"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="TotalText"
                               Text="0"
                               Foreground="#FFF6F7FB"
                               FontSize="24"
                               FontWeight="Bold" />
                </StackPanel>
            </Grid>

            <UniformGrid x:Name="TilePanel"
                         Grid.Row="2"
                         Rows="1"
                         Columns="5" />
        </Grid>
    </Border>
</Window>
