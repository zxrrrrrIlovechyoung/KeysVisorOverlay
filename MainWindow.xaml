<Window x:Class="KeysVisorOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeysVisorOverlay"
        Width="430"
        Height="158"
        MinWidth="250"
        MinHeight="100"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Customize overlay" Click="Customize_Click" />
            <Separator />
            <MenuItem Header="Reset" Click="Reset_Click" />
            <MenuItem Header="Hide / Show" Click="ToggleVisibility_Click" />
            <Separator />
            <MenuItem Header="Exit" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="DragSurface"
            MouseLeftButtonDown="DragSurface_MouseLeftButtonDown"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#55FFFFFF"
            Background="#DC090C12"
            Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.42"
                              Color="#000000" />
        </Border.Effect>

        <Grid x:Name="OverlayGrid"
              ClipToBounds="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="TrailRow" Height="*" MinHeight="128" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="KeysVisorOverlay"
                           Foreground="#FFF6F7FB"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>

            <Grid x:Name="StatsPanel"
                  Grid.Row="1"
                  Margin="0,10,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="KPS"
                               Foreground="#FF9CA3AF"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="KpsText"
                               Text="0"
                               Foreground="#FFF6F7FB"
                               FontSize="34"
                               FontWeight="Bold"
                               LineHeight="35" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="MAX"
                               Foreground="#FF9CA3AF"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="MaxText"
                               Text="0"
                               Foreground="#FFFF8BA7"
                               FontSize="24"
                               FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="AVG"
                               Foreground="#FF9CA3AF"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="AvgText"
                               Text="0.0"
                               Foreground="#FF7DE2D1"
                               FontSize="24"
                               FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="TOTAL"
                               Foreground="#FF9CA3AF"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="TotalText"
                               Text="0"
                               Foreground="#FFF6F7FB"
                               FontSize="24"
                               FontWeight="Bold" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="TilePanel"
                        Grid.Row="3"
                        Orientation="Horizontal" />

            <Border x:Name="TrailViewport"
                    Grid.Row="2"
                    MinHeight="128"
                    Background="Transparent"
                    ClipToBounds="True"
                    IsHitTestVisible="False">
                <Canvas x:Name="TrailCanvas"
                        MinHeight="128"
                        Width="{Binding ActualWidth, ElementName=TrailViewport}"
                        ClipToBounds="True"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False" />
            </Border>
        </Grid>
    </Border>
</Window>
