<Window x:Class="KeysVisorOverlay.CustomizeInputsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize Inputs"
        Width="360"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF090C12">
    <Border BorderThickness="1"
            BorderBrush="#33FFFFFF"
            Padding="14"
            Background="#FF090C12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Customize keys"
                           Foreground="#FFF6F7FB"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="Add any keyboard key or mouse button."
                           Foreground="#FF9CA3AF"
                           FontSize="12"
                           Margin="0,4,0,0" />
            </StackPanel>

            <ListBox x:Name="InputList"
                     Grid.Row="1"
                     Background="#1FFFFFFF"
                     BorderBrush="#33FFFFFF"
                     Foreground="#FFF6F7FB"
                     SelectionMode="Single"
                     Padding="6">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6"
                                Background="#1EFFFFFF"
                                Padding="10,7"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}"
                                           Foreground="#FFF6F7FB"
                                           FontSize="15"
                                           FontWeight="Bold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Code}"
                                           Foreground="#FF9CA3AF"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="CaptureStatusText"
                       Grid.Row="2"
                       Text="Ready"
                       Foreground="#FF7DE2D1"
                       FontSize="12"
                       Margin="0,10,0,10" />

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0"
                             Rows="1"
                             Columns="3"
                             Margin="0,0,0,8">
                    <Button Content="Add"
                            Click="Add_Click"
                            Margin="0,0,6,0"
                            Padding="10,7" />
                    <Button Content="Remove"
                            Click="Remove_Click"
                            Margin="0,0,6,0"
                            Padding="10,7" />
                    <Button Content="D F J K"
                            Click="Defaults_Click"
                            Padding="10,7" />
                </UniformGrid>

                <UniformGrid Grid.Row="1"
                             Rows="1"
                             Columns="2">
                    <Button Content="Cancel"
                            Click="Cancel_Click"
                            Margin="0,0,6,0"
                            Padding="10,7" />
                    <Button Content="Save"
                            Click="Save_Click"
                            Padding="10,7"
                            FontWeight="SemiBold" />
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</Window>
