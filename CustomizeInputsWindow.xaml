<Window x:Class="KeysVisorOverlay.CustomizeInputsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize Overlay"
        Width="360"
        Height="735"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF090C12">
    <Border BorderThickness="1"
            BorderBrush="#33FFFFFF"
            Padding="14"
            Background="#FF090C12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Customize overlay"
                           Foreground="#FFF6F7FB"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="Keys, layout, size, and trail effects."
                           Foreground="#FF9CA3AF"
                           FontSize="12"
                           Margin="0,4,0,0" />
            </StackPanel>

            <ListBox x:Name="InputList"
                     Grid.Row="1"
                     Background="#1FFFFFFF"
                     BorderBrush="#33FFFFFF"
                     Foreground="#FFF6F7FB"
                     SelectionMode="Single"
                     Padding="6">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6"
                                Background="#1EFFFFFF"
                                Padding="10,7"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}"
                                           Foreground="#FFF6F7FB"
                                           FontSize="15"
                                           FontWeight="Bold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Code}"
                                           Foreground="#FF9CA3AF"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="CaptureStatusText"
                       Grid.Row="2"
                       Text="Ready"
                       Foreground="#FF7DE2D1"
                       FontSize="12"
                       Margin="0,10,0,10" />

            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Visuals"
                           Foreground="#FFF6F7FB"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7" />

                <UniformGrid Grid.Row="1"
                             Rows="1"
                             Columns="4"
                             Margin="0,0,0,10">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Stats"
                                   Foreground="#FF9CA3AF"
                                   FontSize="11"
                                   Margin="0,0,0,4" />
                        <ComboBox x:Name="StatsPlacementBox"
                                  SelectedIndex="0"
                                  Padding="8,5">
                            <ComboBoxItem Content="Top" />
                            <ComboBoxItem Content="Bottom" />
                        </ComboBox>
                    </StackPanel>

                    <CheckBox x:Name="TrailsCheckBox"
                              Content="Key trails"
                              Foreground="#FFF6F7FB"
                              VerticalAlignment="Bottom"
                              Margin="6,0,0,6" />

                    <CheckBox x:Name="TransparentBackgroundCheckBox"
                              Content="Transparent"
                              Foreground="#FFF6F7FB"
                              VerticalAlignment="Bottom"
                              Margin="6,0,0,6" />

                    <CheckBox x:Name="BlurBackgroundCheckBox"
                              Content="Blur"
                              Foreground="#FFF6F7FB"
                              VerticalAlignment="Bottom"
                              Margin="6,0,0,6" />
                </UniformGrid>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Press color"
                               Foreground="#FF9CA3AF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button x:Name="PressedColorButton"
                            Grid.Column="1"
                            Content="Choose color"
                            Click="ChoosePressedColor_Click"
                            Padding="8,5" />
                    <Border x:Name="PressedColorPreview"
                            Grid.Column="2"
                            Width="28"
                            Height="28"
                            CornerRadius="5"
                            BorderBrush="#55FFFFFF"
                            BorderThickness="1"
                            Margin="10,0,0,0" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Size"
                               Foreground="#FF9CA3AF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Slider x:Name="ScaleSlider"
                            Grid.Column="1"
                            Minimum="0.7"
                            Maximum="1.6"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="False"
                            ValueChanged="ScaleSlider_ValueChanged" />
                    <TextBlock x:Name="ScaleValueText"
                               Grid.Column="2"
                               Text="100%"
                               Foreground="#FFF6F7FB"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </Grid>

                <Grid Grid.Row="4" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Key width"
                               Foreground="#FF9CA3AF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Slider x:Name="KeyWidthSlider"
                            Grid.Column="1"
                            Minimum="48"
                            Maximum="180"
                            TickFrequency="4"
                            IsSnapToTickEnabled="False"
                            ValueChanged="KeyWidthSlider_ValueChanged" />
                    <TextBlock x:Name="KeyWidthValueText"
                               Grid.Column="2"
                               Text="76"
                               Foreground="#FFF6F7FB"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </Grid>

                <Grid Grid.Row="5" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Key height"
                               Foreground="#FF9CA3AF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Slider x:Name="KeyHeightSlider"
                            Grid.Column="1"
                            Minimum="28"
                            Maximum="96"
                            TickFrequency="2"
                            IsSnapToTickEnabled="False"
                            ValueChanged="KeyHeightSlider_ValueChanged" />
                    <TextBlock x:Name="KeyHeightValueText"
                               Grid.Column="2"
                               Text="34"
                               Foreground="#FFF6F7FB"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Trail height"
                               Foreground="#FF9CA3AF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Slider x:Name="TrailHeightSlider"
                            Grid.Column="1"
                            Minimum="96"
                            Maximum="720"
                            TickFrequency="16"
                            IsSnapToTickEnabled="False"
                            ValueChanged="TrailHeightSlider_ValueChanged" />
                    <TextBlock x:Name="TrailHeightValueText"
                               Grid.Column="2"
                               Text="128"
                               Foreground="#FFF6F7FB"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </Grid>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0"
                             Rows="1"
                             Columns="3"
                             Margin="0,0,0,8">
                    <Button Content="Add"
                            Click="Add_Click"
                            Margin="0,0,6,0"
                            Padding="10,7" />
                    <Button Content="Remove"
                            Click="Remove_Click"
                            Margin="0,0,6,0"
                            Padding="10,7" />
                    <Button Content="D F J K"
                            Click="Defaults_Click"
                            Padding="10,7" />
                </UniformGrid>

                <UniformGrid Grid.Row="1"
                             Rows="1"
                             Columns="2">
                    <Button Content="Cancel"
                            Click="Cancel_Click"
                            Margin="0,0,6,0"
                            Padding="10,7" />
                    <Button Content="Save"
                            Click="Save_Click"
                            Padding="10,7"
                            FontWeight="SemiBold" />
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</Window>
